# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Local dev: skip cross-subdomain cookie domain
NEXT_PUBLIC_AUTH_LOCAL=1

# Production cross-subdomain SSO
# Optional: server-only token to auto-fix Supabase Auth URL via POST /api/admin/fix-supabase-auth
# SUPABASE_ACCESS_TOKEN=sbp_...
# AUTH_ADMIN_SECRET=choose-a-long-random-secret

# Optional site config override
# SITE_CONFIG_PATH=../../site.config.yaml
