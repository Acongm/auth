{
  "name": "@acongm/auth-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm --filter @acongm/auth-app dev",
    "build": "pnpm --filter @acongm/config build && pnpm --filter @acongm/auth-client types:check && pnpm --filter @acongm/auth-app build",
    "typecheck": "pnpm --filter @acongm/config build && pnpm --filter @acongm/auth-client types:check && pnpm -r typecheck",
    "lint": "pnpm --filter @acongm/auth-app lint",
    "ui:list": "node scripts/ui-registry.mjs list",
    "ui:view": "node scripts/ui-registry.mjs view core-ui",
    "ui:add": "node scripts/ui-registry.mjs add core-ui",
    "ui:sync": "node scripts/ui-registry.mjs sync core-ui",
    "ui:diff": "node scripts/ui-registry.mjs diff core-ui",
    "ui:view:forms": "node scripts/ui-registry.mjs view form-ui",
    "ui:add:forms": "node scripts/ui-registry.mjs add form-ui",
    "ui:sync:forms": "node scripts/ui-registry.mjs sync form-ui",
    "ui:diff:forms": "node scripts/ui-registry.mjs diff form-ui",
    "ui:drift": "node scripts/check-ui-drift.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "test:e2e:prod": "playwright test --config=playwright.prod.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  },
  "engines": {
    "node": ">=20"
  }
}
